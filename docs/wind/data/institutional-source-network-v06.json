{
  "version": "0.6.0",
  "as_of": "2026-09-05",
  "purpose": "Institutional and public-source watch for the Italian wind radar, kept separate from the commercial company network and from project-specific contractor evidence.",
  "origin_repo": "EmAnzi3/pv_agent_mvp",
  "principles": [
    "The regional/public-source network is a third intelligence layer: project radar, commercial company network, institutional/source network.",
    "Official regional and national sources can support project identity, configuration, stage, timing and named execution evidence when the document is project-specific.",
    "A source endpoint is not itself evidence: only the content of a specific official act/document can be graded A1.",
    "PV Agent collector endpoints and parsing patterns may be reused, but PV-only keyword filters must not be copied mechanically into the wind radar.",
    "Collectors that explicitly exclude eolico must be adapted before use for wind; their endpoint knowledge remains valuable.",
    "Terna Econnextion is aggregate market intelligence and must not be treated as a project list.",
    "Institutional coverage gaps are explicit and must not be silently interpreted as absence of projects."
  ],
  "monitoring": {
    "national_core_cadence_days": 1,
    "priority_regional_cadence_days": 3,
    "standard_regional_cadence_days": 7,
    "coverage_audit_days": 30,
    "signals": [
      "new VIA/PAUR/screening procedure",
      "new integration, republication or opinion",
      "VIA decree or regional authorization",
      "verification of compliance or construction-related act",
      "grid-connection or substation-related act",
      "project configuration change in MW, WTG, BESS or municipalities",
      "new project document naming an engineering, civil, electrical, logistics, OEM or execution company",
      "voltura, acquisition, SPV or proponent change"
    ]
  },
